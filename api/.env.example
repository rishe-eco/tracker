# Tracker API — environment.
# Copy to `.env` and fill in. Nothing here is read by the client.

# ── Required ────────────────────────────────────────────────────────────────

DATABASE_URL="file:./prisma/dev.db"

# Comma-separated origins allowed to call the GraphQL endpoint.
CORS_ORIGINS="http://localhost:5173"


# ── Optional · Clarity Lab's reader and judge ───────────────────────────────
#
# Leave unset and everything still runs. Evidence Lab needs no credential at
# all, and Clarity Lab falls back to its detectors: R1, R4 and R6 are scored,
# R2, R3 and R5 are reported as unscored with the reason, and elicitation items
# are shown as needing a reader rather than silently omitted.
#
# The issuing account does not matter. The SDK client is constructed from this
# variable alone — nothing is tied to an identity, workspace or project, so a
# key from any account works.
#
# Confirm the key can reach the models pinned in
# src/services/skills/clarity/judge.ts (claude-opus-5 for probes,
# claude-sonnet-5 for practice). Change them there, not at the call site.
#
# See 06-specs/01a-clarity-lab-build-plan.md §4.

# ANTHROPIC_API_KEY="sk-ant-..."

# Accepted as an alternative to ANTHROPIC_API_KEY; either satisfies the check.
# ANTHROPIC_AUTH_TOKEN=""
