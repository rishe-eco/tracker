# Root of the monorepo only — each workspace has its own .gitignore.

node_modules
*.log

# OS junk
.DS_Store
Thumbs.db

# Local agent/editor state
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/worktrees/

# Lane reports and suite logs (lifecycle); never content.
.tmp/

# The box's web releases and the link to the live one (deploy/tracker-deploy.sh); never content.
/releases/
/current
/.current.tmp
