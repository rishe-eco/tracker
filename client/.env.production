# Same-origin: the app and its GraphQL API are served from the same domain,
# nginx routes /graphql to the backend container. Relative URL keeps it portable.
VITE_API_URL="/graphql"
# Previous split-subdomain setup (kept for reference):
# VITE_API_URL="https://trackerApi.m-root.com/graphql"
# VITE_API_URL=http://51.75.182.113:4000/graphql